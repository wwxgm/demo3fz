{
  "expo": {
    "name": "IphoneHello",
    "slug": "iphone-hello",
    "version": "1.7.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.local.iphonehello",
      "buildNumber": "12",
      "infoPlist": {
        "CFBundleDisplayName": "视频翻转",
        "NSPhotoLibraryUsageDescription": "需要访问相册，以选择图片或视频，并把处理后的文件保存到相册。",
        "NSPhotoLibraryAddUsageDescription": "需要把处理后的图片和视频保存到你的手机相册。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.local.iphonehello"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIosBuild.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "需要访问相册，以选择要处理的图片或视频。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "需要访问相册，以选择图片或视频，并把处理后的文件保存到相册。",
          "savePhotosPermission": "需要把处理后的图片和视频保存到你的手机相册。",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
