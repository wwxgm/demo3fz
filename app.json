{
  "expo": {
    "name": "IphoneHello",
    "slug": "iphone-hello",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F33"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.local.iphonehello",
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "视频翻转",
        "NSPhotoLibraryUsageDescription": "需要访问相册，以选择视频并把翻转后的视频保存到相册。",
        "NSPhotoLibraryAddUsageDescription": "需要把水平翻转后的视频保存到你的手机相册。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F33"
      },
      "package": "com.local.iphonehello"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "需要访问相册，以选择要水平翻转的视频。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "需要访问相册，以选择视频并把翻转后的视频保存到相册。",
          "savePhotosPermission": "需要把水平翻转后的视频保存到你的手机相册。",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
